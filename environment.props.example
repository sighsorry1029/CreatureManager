<Project>
  <!-- Copy this file to environment.props for machine-local paths. -->
  <PropertyGroup>
    <GamePath>C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <BepInExPath>$(GamePath)\BepInEx</BepInExPath>
    <CorlibPath>$(GamePath)\valheim_Data\Managed</CorlibPath>
    <!-- Use original 1.0.7 DLLs. Compile-only publicized copies are generated under obj. -->

    <!-- Debug validation: dotnet build CreatureManager.sln -c Debug -p:DeployToGame=true -->
    <DeployToGame>false</DeployToGame>
    <GamePluginDirectory>$(BepInExPath)\plugins</GamePluginDirectory>
    <!-- Legacy optional deployment settings. -->
    <DeployToValheim>false</DeployToValheim>
    <CopyOutputDLLPath>$(BepInExPath)\plugins</CopyOutputDLLPath>

    <!-- Release builds use the project's existing Thunderstore ZIP packaging by default. -->
  </PropertyGroup>
</Project>
